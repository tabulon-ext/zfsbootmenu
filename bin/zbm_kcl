#!/bin/bash
# vim: softtabstop=2 shiftwidth=2 expandtab

usage() {
  cat <<-EOF
	USAGE: $0 [-a <arg>] [-r <arg>] [-e] [-d] [bootenv]
        Review or update kernel command line (KCL) associated with <bootenv>
        When the boot environment is specified, the current root will be used

	-a <arg>: Append an argument
	-r <arg>: Remove an argument
	-e: Open the KCL for editing in \$EDITOR
	-d: Remove entire command line
	EOF
}

error() {
  echo "$@" >&2
}

delete() {
  local bootenv="${1}"

  if ! zfs list -o name -H "${bootenv}" >/dev/null 2>&1; then
    error "ERROR: no boot environment specified"
    usage
    return 1
  fi

  if ! zfs inherit org.zfsbootmenu:commandline "${bootenv}"; then
    error "ERROR: failed to remove KCL from ${bootenv}"
    return 1
  fi
}



edit() {
  local bootenv kclfile oldsum newkcl newsum

  bootenv="${1}"
  kclfile="$(mktemp)"

  trap 'rm -f "${kclfile}"' RETURN

  if [ -z "${EDITOR}" ]; then
    error "ERROR: define \$EDITOR to edit"
    return 1
  fi

  if ! review "${bootenv}" > "${kclfile}"; then
    error "ERROR: unable to read KCL for ${bootenv}"
    return 1
  fi

  if ! oldsum="$(md5sum "${kclfile}" | awk '{print $1}')"; then
    error "ERROR: unable to compute checksum for existing KCL"
    return 1
  fi

  cat >> "${kclfile}" <<-EOF
	
	# KCL processing ends with the first line that contains no text.
	# Anything starting with # is considered a comment and will be ignored.
	# Multiple lines will be concatenated with spaces to form a single line.
	EOF

  if ! "${EDITOR}" "${kclfile}"; then
    error "ERROR: failed to edit KCL for ${bootenv}"
    return 1
  fi

  if ! newkcl="$(awk '
    BEGIN { first = 1; }

    /^$/ { exit; }

    {
      gsub("[[:space:]]*#.*", "");

      if (length == 0) next;

      if (first == 1) {
        first = 0;
      } else {
        printf " ";
      }

      printf "%s", $0;
    }
  ' < "${kclfile}")"; then
    error "ERROR: failed to parse new KCL for ${bootenv}"
    return 1
  fi

  if ! newsum="$(echo "${newkcl}" | md5sum | awk '{print $1}')"; then
    error "ERROR: failed to compute checksum for new KCL"
    return 1
  fi

  if  [ "${newsum}" = "${oldsum}" ]; then
    error "NOTICE: modified KCL appears the same as original, will not change"
    return 0
  fi

  zfs set org.zfsbootmenu:commandline="${newkcl}" "${bootenv}"
}

remove() {
  local unwanted varname

  unwanted="${1}"
  shift

  if [ -z "${unwanted}" ]; then
    echo "$*"
    return 0
  fi

  varname="${unwanted%%=*}"
  if [ "${varname}" != "${unwanted}" ]; then
    error "ERROR: specify variable names without values to remove"
    return 1
  fi

  awk <<< "$*" '
  BEGIN {
    quot = 0;
    supp = 0;
    ORS = " ";
  }

  {
    for (i = 1; i <= NF; i++) {
      if ( quot == 0 ) {
        # If unquoted, determine if output should be suppressed
        if ( $(i) ~ /^'"${unwanted}"'=/ ) {
          # Suppress unwanted argument
          supp = 1;
        } else {
          # Nothing else is suppressed
          supp = 0;
        }
      }

      # If output is not suppressed, print field
      if ( supp == 0 && length($(i)) > 0 ) {
        if ( i < NF ) {
          print $(i)
        } else {
          printf "%s", $(i);
        }
      }

      # If an odd number of quotes are in field, toggle quoting
      if ( gsub(/"/, "\"", $(i)) % 2 == 1 ) {
        quot = (quot + 1) % 2;
      }
    }
  }
  '
}

review() {
  local bootenv="${1}"
  local kcl

  kcl="$(zfs get -H -o value org.zfsbootmenu:commandline "${bootenv}")" || return 1

  [ "${kcl}" = "-" ] || echo "${kcl}"
  return 0
}

getbootenv() {
  local dev mntpt fs opts

  # shellcheck disable=SC2034
  while read -r dev mntpt fs opts; do
    [ "${mntpt}" = "/" ] || continue

    if [ "${fs}" != "zfs" ]; then
      error "ERROR: root does not appear to be ZFS" >&2
      return 1
    fi

    echo "${dev}"
    return 0
  done < /proc/mounts
}

delkcl=
editkcl=
havemods=
appends=()
removes=()

while getopts "ha:r:ed" opt; do
  case "${opt}" in
    a)
      appends+=( "${OPTARG}" )
      ;;
    r)
      removes+=( "${OPTARG}" )
      ;;
    e)
      editkcl="yes"
      ;;
    d)
      delkcl="yes"
      ;;
    h)
      usage
      exit
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

shift $((OPTIND-1))

bootenv="${1}"
if [ -z "${bootenv}" ]; then
  if ! bootenv="$(getbootenv)"; then
    exit 1
  fi
fi

if ! zfs list -o name -H "${bootenv}" >/dev/null 2>&1; then
  error "ERROR: boot environment ${bootenv} does not exist"
  exit 1
fi

if [ "${editkcl}" = "yes" ]; then
  edit "${bootenv}"
  exit
fi

if (( ${#removes[@]} != 0 || ${#appends[@]} != 0 )); then
  havemods="yes"
fi

if [ "${delkcl}" ]; then
  if [ "${havemods}" = "yes" ]; then
    error "ERROR: -d is incompatible with -a or -r"
    exit 1
  fi

  delete "${bootenv}"
  exit
fi

kcl="$(review "${bootenv}")"

if [ "${havemods}" != "yes" ]; then
  echo "${kcl}"
  exit 0
fi

# Strip all unwanted arguments from the KCL
for rem in "${removes[@]}"; do
  kcl="$(remove "${rem}" "${kcl}")" || exit 1
done

for add in "${appends[@]}"; do
  if [ -z "${kcl}" ]; then
    kcl="${add}"
  else
    kcl+=" ${add}"
  fi
done

if ! zfs set org.zfsbootmenu:commandline="${kcl}" "${bootenv}"; then
  error "ERROR: failed to set ZBM KCL"
  exit 1
fi
